[Unit]
Description=WhatsApp Family Assistant Bot - Python backend (FastAPI + Ollama client)
Documentation=file:///opt/family-whatsapp-bot/knowledge.md
After=network-online.target ollama.service
Wants=network-online.target
# Remove the next line if Ollama is not installed as a systemd service:
Requires=ollama.service

[Service]
Type=simple
User=familybot
Group=familybot
WorkingDirectory=/opt/family-whatsapp-bot
# EnvironmentFile holds WHITELISTED_NUMBERS, OLLAMA_*, BRIDGE_SHARED_SECRET…
EnvironmentFile=/opt/family-whatsapp-bot/.env
ExecStart=/opt/family-whatsapp-bot/.venv/bin/uvicorn \
    family_whatsapp_bot.server:app \
    --host 127.0.0.1 --port 8000 --workers 1
# Single worker on purpose: the asyncio queue serialises all Ollama calls
# (prevents two workers from thrashing model weights in VRAM — review fix #3).
Restart=always
RestartSec=3
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/family-whatsapp-bot /tmp

[Install]
WantedBy=multi-user.target
