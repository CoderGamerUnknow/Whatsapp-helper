# ---------------------------------------------------------------------------
# WhatsApp Family Assistant Bot — environment configuration (template)
# Copy to the project root as .env and edit. Every value has a working default
# if omitted (see family_whatsapp_bot/config.py).
# ---------------------------------------------------------------------------

# --- SECURITY: the ONLY numbers allowed to talk to the bot (spec §3) --------
# Exactly 3 numbers, in order: dad, mom, user. Anything else is dropped.
# Format: comma separated, E.164 (with country code).
WHITELISTED_NUMBERS=+12345678901,+12345678902,+12345678903

# --- Ollama (ONE multimodal model for text + vision — VRAM fix #3) ----------
OLLAMA_BASE_URL=http://localhost:11434
# qwen2.5-vl and llama3.2-vision both do text+images in one model.
# Text-only alternatives (needs >=16GB VRAM to split — see README):
#   OLLAMA_MODEL=qwen2.5:7b   (then set OLLAMA_VISION_MODEL separately)
OLLAMA_MODEL=llama3.2-vision
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_PROBE_TIMEOUT_SECONDS=2

# --- Bridge (Node.js / Baileys) ---------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8790
# MUST match between backend .env and bridge .env — change it from the default.
BRIDGE_SHARED_SECRET=change-me-to-a-long-random-string

# --- Whisper (voice notes) ----------------------------------------------------
WHISPER_MODEL_SIZE=base        # tiny < base < small < medium (size/speed/accuracy)
WHISPER_DEVICE=auto            # auto | cpu | cuda
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=              # leave empty to auto-detect

# --- Database / behaviour -----------------------------------------------------
# DB_PATH=/opt/family-whatsapp-bot/family_hub.db
CONTEXT_WINDOW_SIZE=8          # sliding window: last N messages to the LLM
PENDING_CONFIRMATION_TTL_SECONDS=300
CURRENCY_SYMBOL=$
MEDIA_DIR=/tmp/family-bot-media
